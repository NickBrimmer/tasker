{
  "name": "tasker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite --port $(printenv PORT || echo 3000)",
    "build": "bunx --bun react-router build",
    "start": "bunx --bun react-router-serve ./build/server/index.js",
    "check": "NODE_ENV=development bunx --bun react-router typegen && tsc",
    "test": "bun test",
    "reset": "bun run scripts/reset.ts"
  },
  "dependencies": {
    "@react-router/node": "7.18.0",
    "@react-router/serve": "7.18.0",
    "isbot": "^5.1.31",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "7.18.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.3.5",
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^6.0.3",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
